# PostgreSQL values used by docker-compose.yml for local development.
POSTGRES_DB=masjid_management
POSTGRES_USER=masjid_user
POSTGRES_PASSWORD=change-me-postgres-password

# Browser-facing API URL compiled into the Flutter Web image.
FRONTEND_API_BASE_URL=http://localhost:3000/api/v1

# Allowed browser origins for the backend when running with Docker.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Public tunnel (optional, see docs/DOCKER.md). Uncomment COMPOSE_PROFILES to start it
# with "docker compose up -d", and put NGROK_AUTHTOKEN=... in .env.tunnel.
# COMPOSE_PROFILES=tunnel
NGROK_DOMAIN=your-domain.ngrok-free.app
