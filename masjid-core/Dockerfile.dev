FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
COPY prisma.config.ts ./
# prisma.config.ts requires DATABASE_URL; generate never connects, so a placeholder works.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm run prisma:generate
EXPOSE 3000
CMD ["sh", "-c", "npm run prisma:generate && npm run start:dev"]
