# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PRISMA_LOG_QUERIES=false
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Database
# Use localhost:5433 from your host machine. Docker Compose overrides this to use hostname "postgres" inside containers.
DATABASE_URL=postgresql://masjid_user:change-me-postgres-password@localhost:5433/masjid_management

# JWT - replace with long random values before sharing any non-local environment.
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional one-time bootstrap values for: npm run bootstrap:super-admin
SUPER_ADMIN_FULL_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PHONE=+10000000000
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-super-admin-password
