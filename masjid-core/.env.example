# Application
# development | test | staging | production
# production refuses to start until real SMS OTP exists (milestone M6).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PRISMA_LOG_QUERIES=false
# Comma separated. Required in staging and production. Empty in development allows any origin.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Set to true when the API runs behind Caddy/nginx so rate limits see the real client IP.
TRUST_PROXY=false
# Defaults: Swagger on outside production, rate limiting always on.
# SWAGGER_ENABLED=true
# RATE_LIMIT_ENABLED=true

# Database
# Use localhost:5433 from your host machine. Docker Compose overrides this to use hostname "postgres" inside containers.
DATABASE_URL=postgresql://masjid_user:change-me-postgres-password@localhost:5433/masjid_management
# Most database connections the API keeps open (default 10; keep low on a small VPS).
# DB_POOL_MAX=10

# JWT - at least 16 characters (32 in staging/production) and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Development auth (on by default outside production, forbidden in production).
# Every OTP is AUTH_DEV_OTP and new imam/committee users get AUTH_DEV_PASSWORD.
AUTH_DEV_MODE=true
AUTH_DEV_OTP=1111
AUTH_DEV_PASSWORD=12345678
# Used only when AUTH_DEV_MODE=false (the code is then printed to the server log until SMS lands in M6).
# AUTH_OTP_LENGTH=6
# AUTH_OTP_TTL_SECONDS=300
# AUTH_OTP_MAX_ATTEMPTS=5

# Optional one-time bootstrap values for: npm run bootstrap:super-admin
SUPER_ADMIN_FULL_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PHONE=+10000000000
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-super-admin-password
